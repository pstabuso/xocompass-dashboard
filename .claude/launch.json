{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "XoCompass Frontend (Vite dev)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 5173
    },
    {
      "name": "XoCompass Frontend (Vite preview)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "preview"],
      "port": 4173
    },
    {
      "name": "XoCompass Backend (FastAPI SARIMAX)",
      "runtimeExecutable": "uvicorn",
      "runtimeArgs": ["main:app", "--reload", "--port", "8000"],
      "port": 8000
    }
  ]
}
