# ╔═══════════════════════════════════════════════════════════════╗
# ║  XoCompass Environment Variables                             ║
# ║  Copy this file to .env and fill in your Supabase values     ║
# ╚═══════════════════════════════════════════════════════════════╝

# Supabase (required for real-time cloud sync)
# Get these from: https://supabase.com/dashboard → Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# RLS Hardening: Team secret for write-gated policies (Phase 1)
# Must match the value set in Supabase Dashboard → Database Settings:
#   ALTER DATABASE postgres SET app.settings.team_secret = 'your-secret';
VITE_SUPABASE_TEAM_SECRET=xocompass-leap-2026

# Python SARIMAX Backend (Phase 2 — optional)
# URL of the FastAPI microservice for model predictions
VITE_SARIMAX_API_URL=http://localhost:8000
